{
	"i18n": true,
	"type": "panel",
	"items": {
		"_info": {
			"type": "staticText",
			"text": "Unofficial adapter for BassT23's Ultimate Updater (github.com/BassT23/Proxmox). Updates are only started by pressing a button – never automatically.",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"ip": {
			"type": "text",
			"label": "IP address / host name",
			"help": "Address of the Ultimate Updater Web UI, e.g. 192.168.1.10",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"port": {
			"type": "number",
			"label": "Port",
			"help": "Web UI port, default 8765",
			"min": 1,
			"max": 65535,
			"xs": 12,
			"sm": 6,
			"md": 3,
			"lg": 2,
			"xl": 2
		},
		"https": {
			"type": "checkbox",
			"label": "Use HTTPS",
			"xs": 12,
			"sm": 6,
			"md": 3,
			"lg": 2,
			"xl": 2
		},
		"credentialMode": {
			"type": "select",
			"label": "Login data",
			"options": [
				{
					"label": "Enter here",
					"value": "manual"
				},
				{
					"label": "From the credentials manager (admin settings)",
					"value": "manager"
				}
			],
			"help": "The credentials manager needs admin 7.9 and js-controller 7.2.2 or newer",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"credentialId": {
			"type": "credential",
			"label": "Proxmox login",
			"help": "A \"Login & password\" credential, e.g. root@pam",
			"hidden": "data.credentialMode !== 'manager'",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"username": {
			"type": "text",
			"label": "Username",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4,
			"help": "Proxmox user without @realm, e.g. root. Needs full Administrator rights at \"/\" and no 2FA.",
			"hidden": "data.credentialMode === 'manager'"
		},
		"password": {
			"type": "password",
			"label": "Password",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4,
			"repeat": false,
			"hidden": "data.credentialMode === 'manager'"
		},
		"realm": {
			"type": "text",
			"label": "Realm",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4,
			"help": "Authentication domain as shown on the Web UI login, e.g. pam or pve"
		},
		"validateCertificate": {
			"type": "checkbox",
			"label": "Validate TLS certificate",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"refreshInterval": {
			"type": "number",
			"label": "Full status refresh (minutes)",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4,
			"min": 1,
			"max": 35791
		},
		"pollIdle": {
			"type": "number",
			"label": "Job poll interval when idle (seconds)",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4,
			"min": 5,
			"max": 86400
		},
		"pollBusy": {
			"type": "number",
			"label": "Job poll interval while a job is running (seconds)",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4,
			"min": 1,
			"max": 86400
		},
		"_hdrActions": {
			"type": "header",
			"text": "Updates and actions",
			"size": 4,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"excludeTargets": {
			"type": "selectSendTo",
			"command": "getTargets",
			"multiple": true,
			"noTranslation": true,
			"label": "Excluded from \"update all\"",
			"help": "These VMs/CTs are skipped by the collective update buttons. They can still be updated individually. The list is loaded from the running instance.",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 8,
			"xl": 8
		},
		"allowReboot": {
			"type": "checkbox",
			"label": "Allow reboot buttons",
			"help": "Creates a reboot button for hosts/VMs/CTs that need a reboot. Off by default.",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"deleteStaleTargets": {
			"type": "checkbox",
			"label": "Delete targets that no longer exist",
			"help": "Removes the states of hosts/VMs/CTs that Ultimate Updater no longer reports (e.g. deleted in Proxmox). If off, they are kept.",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"_hdrNotify": {
			"type": "header",
			"text": "Notifications",
			"size": 4,
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"_notifyInfo": {
			"type": "staticText",
			"text": "Sent via the ioBroker notification manager (Telegram, e-mail, … are configured there). Only changes are notified.",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 12,
			"lg": 12,
			"xl": 12
		},
		"notifySecurity": {
			"type": "checkbox",
			"label": "New security updates",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"notifyReboot": {
			"type": "checkbox",
			"label": "Reboot required",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		},
		"notifyJobFailed": {
			"type": "checkbox",
			"label": "Job failed or interrupted",
			"newLine": true,
			"xs": 12,
			"sm": 12,
			"md": 6,
			"lg": 4,
			"xl": 4
		}
	}
}
